```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
*.log

# Database files
*.db

# Environment files
.env
.env.local
*.env.*

# Dependencies
venv/
.venv/
.env/

# Build artifacts
dist/
build/
target/

# Coverage reports
coverage/
htmlcov/
.coverage

# MyPy cache
.mypy_cache/

# Pytest cache
.pytest_cache/

# Editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS files
.DS_Store
Thumbs.db
```